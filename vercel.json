{
  "version": 2,
  "builds": [
    {
      "src": "**/*.{html,jpg,jpeg,png,gif,svg,ico,webp,js,css,json,woff2,txt,xml}",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "^/index\\.html$",
      "headers": { "Location": "/" },
      "status": 301
    },
    {
      "src": "^/index$",
      "headers": { "Location": "/" },
      "status": 301
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "src": "^/about$",
      "dest": "/about/index.html"
    },
    {
      "src": "^/services$",
      "dest": "/services/index.html"
    },
    {
      "src": "^/contact$",
      "dest": "/contact/index.html"
    },
    {
      "src": "^/admin$",
      "dest": "/admin/index.html"
    },
    {
      "src": "^/analytics$",
      "dest": "/analytics/index.html"
    },
    {
      "src": "^/events$",
      "dest": "/events/index.html"
    },
    {
      "src": "^/diagnostic$",
      "dest": "/diagnostic/index.html"
    },
    {
      "src": "^/(about|services|contact|admin|analytics|events|diagnostic)/$",
      "dest": "/$1/index.html"
    },
    {
      "src": "^/api/analytics$",
      "dest": "/api/analytics.js"
    },
    {
      "src": "^/api/event$",
      "dest": "/api/event.js"
    },
    {
      "src": "^/api/submit$",
      "dest": "/api/submit.js"
    },
    {
      "src": "^/api/leads$",
      "dest": "/api/leads.js"
    },
    {
      "src": "^/api/lead$",
      "dest": "/api/lead.js"
    },
    {
      "src": "^/(.*\\..*)$",
      "dest": "/$1"
    }
  ]
}
